# ──────────────────────────────────────────────
# Spectra Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Feature Flags ────────────────────────────
MODULE_1_MARKET_INTEL=true
MODULE_2_STRATEGY_FORGE=true
MODULE_3_FLOW_RADAR=true
B402_MODE=shadow
TRADFI_SOURCE=yfinance
AGENT_STUDIO_ENABLED=false
TELEGRAM_ALERTS=false
LIVE_TRADING=false
MAX_LIVE_TRADE_USD=10
SIGNAL_WEEKEND_PREMIUM=false

# ── Binance Web3 APIs ───────────────────────
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_RWA_BASE_URL=https://api.binance.com

# ── External Data Sources ────────────────────
FINNHUB_API_KEY=
BSCSCAN_API_KEY=

# ── Database ─────────────────────────────────
DATABASE_URL=
REDIS_URL=

# ── b402 Payments ────────────────────────────
B402_API_KEY=
B402_SECRET_KEY=
B402_PAY_TO_ADDRESS=

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── BSC RPC ──────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ── Deployment ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
