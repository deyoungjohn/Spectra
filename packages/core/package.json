      "import": "./dist/normalize/index.js",
      "types": "./dist/normalize/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./signals": {
      "import": "./dist/signals/index.js",
      "types": "./dist/signals/index.d.ts"
    },
    "./policy": {
      "import": "./dist/policy/index.js",
      "types": "./dist/policy/index.d.ts"
    },
    "./flow": {
      "import": "./dist/flow/index.js",
      "types": "./dist/flow/index.d.ts"
    },
    "./strategy": {
      "import": "./dist/strategy/index.js",
      "types": "./dist/strategy/index.d.ts"
    },
    "./b402": {
      "import": "./dist/b402/index.js",
      "types": "./dist/b402/index.d.ts"
    },
